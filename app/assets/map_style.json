{
  "version": 8,
  "name": "Pieno",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    { "id": "sfondo", "type": "background", "paint": { "background-color": "#E7EDEE" } },
    {
      "id": "verde",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "wood", "grass", "meadow", "scrub", "forest"],
      "paint": { "fill-color": "#D6E7DF", "fill-opacity": 0.9 }
    },
    {
      "id": "parchi",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "fill-color": "#D6E7DF", "fill-opacity": 0.9 }
    },
    {
      "id": "acqua",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#D3E4EA" }
    },
    {
      "id": "edifici",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": { "fill-color": "#DFE7E8" }
    },
    {
      "id": "strade-minori",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track", "path"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 16, 4, 18, 6]
      }
    },
    {
      "id": "strade-principali",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary", "secondary", "tertiary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 12, 4, 15, 9, 18, 17]
      }
    }
  ]
}
